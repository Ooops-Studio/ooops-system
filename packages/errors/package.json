{
	"name": "@ooopsstudio/errors",
	"version": "0.9.1",
	"description": "Error normalization, classification, redaction, reporting, and Sentry delivery for Ooops System applications.",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {"types": "./dist/index.d.ts", "import": "./dist/index.js"},
		"./sinks": {"types": "./dist/sinks/index.d.ts", "import": "./dist/sinks/index.js"},
		"./development": {"types": "./dist/development.d.ts", "import": "./dist/development.js"},
		"./production": {"types": "./dist/production.d.ts", "import": "./dist/production.js"},
		"./custom": {"types": "./dist/custom.d.ts", "import": "./dist/custom.js"},
		"./sentry": {"types": "./dist/sentry.d.ts", "import": "./dist/sentry.js"},
		"./public/types": {"types": "./dist/public/types.d.ts", "import": "./dist/public/types.js"}
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build": "tsup",
		"test": "vitest run",
		"test:integration": "vitest run test/integration/*.integration.test.ts",
		"size": "node size-audit.mjs",
		"depcruise": "depcruise --config ../../.dependency-cruiser.cjs ../../packages/errors/src",
		"publint": "publint",
		"attw": "attw --pack --ignore-rules no-resolution --ignore-rules cjs-resolves-to-esm"
	},
	"license": "MIT",
	"engines": {
		"node": ">=22.14.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ooops-studio/ooops-system.git"
	},
	"homepage": "https://github.com/ooops-studio/ooops-system",
	"bugs": {
		"url": "https://github.com/ooops-studio/ooops-system/issues"
	},
	"sideEffects": false,
	"dependencies": {
		"@ooopsstudio/core": "workspace:^"
	}
}
